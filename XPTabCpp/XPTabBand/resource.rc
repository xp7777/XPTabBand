// XPTabBand resource file
// Embeds the application icon in the DLL (visible in Explorer toolbar menu
// and in file properties of XPTabBand.dll).

#include <windows.h>

// Application icon (multi-size ICO)
// ID 101 is referenced by DllRegisterServer for CLSID\DefaultIcon registry.
101 ICON "XPTabBand.ico"

// Version info block
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XPTabCpp Project"
            VALUE "FileDescription", "XPTabBand - Chrome-style tabs for Windows Explorer"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "XPTabBand"
            VALUE "LegalCopyright", "Copyright (C) 2026, GPL-3.0"
            VALUE "OriginalFilename", "XPTabBand.dll"
            VALUE "ProductName", "XPTabBand"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
