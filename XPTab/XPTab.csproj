<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8：Windows 10/11 内置运行时，explorer.exe 加载无需额外安装 -->
    <TargetFramework>net48</TargetFramework>
    <!-- Explorer Band 必须 x64（现代 explorer.exe 是 64 位） -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- 启用 WinForms：Band UI 用 WinForms 简化开发 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XPTab</AssemblyName>
    <RootNamespace>XPTab</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 生成 DLL 而非 EXE -->
    <OutputType>Library</OutputType>
    <!-- COM 可见：让 COM 客户端（explorer.exe）能创建我们的对象 -->
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>

  <!-- 统一输出目录，方便 regasm 注册 -->
  <PropertyGroup>
    <BaseOutputPath>..\build\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)</OutputPath>
    <!-- 不在输出路径追加 TargetFramework 子目录 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 强名称（可选，COM 注册更稳定；测试阶段先不签） -->
  <PropertyGroup>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!-- 排除独立工具文件，它们单独编译为 exe -->
  <ItemGroup>
    <Compile Remove="Registrar.cs" />
    <Compile Remove="BandEnabler.cs" />
    <Compile Remove="TestHost.cs" />
  </ItemGroup>

</Project>
